{
  "version": 1,
  "notes": "Hand-built hierarchy for the genre and mood labels in songs.csv. Judgements, not measured from data.",
  "genres": {
    "families": {
      "pop":        {"description": "Mainstream, hook-driven", "members": ["pop", "indie pop"]},
      "electronic": {"description": "Synth and beat driven",   "members": ["edm", "synthwave"]},
      "downtempo":  {"description": "Low-energy, textural",    "members": ["lofi", "ambient"]},
      "heavy":      {"description": "Loud, guitar driven",     "members": ["rock", "metal"]},
      "groove":     {"description": "Rhythm and vocal led",    "members": ["hip-hop", "r&b", "reggae"]},
      "roots":      {"description": "Acoustic, song-centred",  "members": ["folk", "country"]},
      "instrumental": {"description": "Largely instrumental, composition-led", "members": ["jazz", "classical"]}
    },
    "adjacent": [
      ["pop", "edm"], ["folk", "indie pop"], ["lofi", "jazz"], ["ambient", "classical"]
    ]
  },
  "moods": {
    "clusters": {
      "calm":     {"arousal": "low",  "valence": "high",    "members": ["chill", "relaxed", "laid-back", "focused"]},
      "upbeat":   {"arousal": "high", "valence": "high",    "members": ["happy", "euphoric", "confident"]},
      "intense":  {"arousal": "high", "valence": "low",     "members": ["intense", "aggressive"]},
      "downcast": {"arousal": "low",  "valence": "low",     "members": ["sad", "melancholic", "moody"]},
      "wistful":  {"arousal": "low",  "valence": "high",    "members": ["nostalgic", "romantic"]}
    },
    "adjacent": [
      ["moody", "intense"], ["nostalgic", "melancholic"], ["romantic", "happy"], ["confident", "intense"],
      ["relaxed", "nostalgic"], ["relaxed", "romantic"]
    ]
  },
  "credit": {
    "same_family": 0.5,
    "adjacent": 0.5,
    "same_cluster": 0.6,
    "adjacent_cluster_pair": 0.3
  }
}
